generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  avatarColor        String               @default("#0C66E4")
  // Incremented on password change/reset; tokens carrying an older value are rejected.
  tokenVersion       Int                  @default(0)
  emailNotifications Boolean              @default(true)
  createdAt          DateTime             @default(now())
  memberships        ProjectMember[]
  ledProjects        Project[]            @relation("ProjectLead")
  assigned           Issue[]              @relation("Assignee")
  reported           Issue[]              @relation("Reporter")
  comments           Comment[]
  activities         Activity[]
  attachments        Attachment[]
  watching           Watcher[]
  notifications      Notification[]       @relation("NotificationRecipient")
  actedNotifications Notification[]       @relation("NotificationActor")
  createdLinks       IssueLink[]
  resetTokens        PasswordResetToken[]
  savedFilters       SavedFilter[]
  automationRules    AutomationRule[]
  // Internal accounts (e.g. the automation actor): cannot log in, hidden from user lists.
  isSystem           Boolean              @default(false)
}

model Project {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  description     String           @default("")
  leadId          String
  lead            User             @relation("ProjectLead", fields: [leadId], references: [id])
  issueCounter    Int              @default(0)
  sprintCounter   Int              @default(0)
  createdAt       DateTime         @default(now())
  members         ProjectMember[]
  issues          Issue[]
  sprints         Sprint[]
  statuses        ProjectStatus[]
  customFields    CustomField[]
  automationRules AutomationRule[]
}

// role: ADMIN | MEMBER
model ProjectMember {
  projectId String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

// status: PLANNED | ACTIVE | CLOSED
model Sprint {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  goal        String        @default("")
  status      String        @default("PLANNED")
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  issues      Issue[]
  events      SprintEvent[]
}

// type: EPIC | STORY | TASK | BUG | SUBTASK
// priority: HIGHEST | HIGH | MEDIUM | LOW | LOWEST
// labels: stored as ",a,b," so a label can be matched exactly with `contains`
model Issue {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number        Int
  key           String             @unique
  title         String
  description   String             @default("")
  type          String             @default("TASK")
  status        String             @default("TODO")
  // status holds a ProjectStatus key; "done" means statusRef.category == DONE.
  statusRef     ProjectStatus      @relation(fields: [projectId, status], references: [projectId, key], onDelete: NoAction, onUpdate: Cascade)
  priority      String             @default("MEDIUM")
  storyPoints   Int?
  labels        String             @default("")
  dueDate       DateTime?
  // Planned start (used by the timeline); dueDate is the planned end.
  startDate     DateTime?
  // When the issue last entered DONE; null while not done.
  resolvedAt    DateTime?
  rank          Float              @default(0)
  assigneeId    String?
  assignee      User?              @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId    String
  reporter      User               @relation("Reporter", fields: [reporterId], references: [id])
  sprintId      String?
  sprint        Sprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentId      String?
  parent        Issue?             @relation("IssueParent", fields: [parentId], references: [id], onDelete: SetNull)
  children      Issue[]            @relation("IssueParent")
  comments      Comment[]
  activities    Activity[]
  attachments   Attachment[]
  watchers      Watcher[]
  notifications Notification[]
  linksOut      IssueLink[]        @relation("LinkSource")
  linksIn       IssueLink[]        @relation("LinkTarget")
  customValues  CustomFieldValue[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([projectId, number])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// action: created | updated | commented
model Activity {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  field     String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  // File name inside UPLOAD_DIR
  storageKey String   @unique
  createdAt  DateTime @default(now())
}

model Watcher {
  issueId   String
  userId    String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([issueId, userId])
}

// type: assigned | mentioned | commented | status
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  type      String
  // Short context, e.g. the new status or a comment excerpt
  detail    String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// type: BLOCKS | RELATES | DUPLICATES — read as "source <type> target"
model IssueLink {
  id          String   @id @default(cuid())
  type        String
  sourceId    String
  source      Issue    @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId    String
  target      Issue    @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([sourceId, targetId, type])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 of the token sent by e-mail; the raw token is never stored
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Append-only log of what happened inside an ACTIVE sprint; burndown, velocity and the
// sprint report are computed by replaying it. issueId is deliberately not a foreign key
// so the history survives when an issue is deleted.
// type: committed (start snapshot) | added | removed | done | reopened | points
model SprintEvent {
  id       String   @id @default(cuid())
  sprintId String
  sprint   Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  issueId  String
  issueKey String
  type     String
  // Story points at the time of the event (added / points)
  points   Int?
  // Whether the issue was done when added
  done     Boolean  @default(false)
  at       DateTime @default(now())

  @@index([sprintId, at])
}

// A column of the project's workflow. Any status can move to any other (simplified workflow).
// category: TODO | IN_PROGRESS | DONE — drives reports, sprint completion and resolution dates.
model ProjectStatus {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Stable identifier stored on issues; the display name can change freely.
  key       String
  name      String
  category  String
  position  Int
  // Board column limit; exceeding it is flagged, not blocked.
  wipLimit  Int?
  issues    Issue[]

  @@unique([projectId, key])
}

// type: TEXT | NUMBER | DATE | SELECT ; options: JSON array of strings (SELECT)
model CustomField {
  id        String             @id @default(cuid())
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String
  options   String             @default("[]")
  position  Int
  createdAt DateTime           @default(now())
  values    CustomFieldValue[]

  @@unique([projectId, name])
}

// Values are stored as text: numbers in canonical form, dates as YYYY-MM-DD.
model CustomFieldValue {
  issueId String
  fieldId String
  value   String
  issue   Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([issueId, fieldId])
}

model SavedFilter {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  jql       String
  // Shared filters are visible to everyone; results are still limited to each viewer's projects.
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// trigger: issue_created | status_changed | assignee_changed | comment_added | subtasks_done
// condition: optional JQL the issue must match; actions: JSON array of { type, value }
model AutomationRule {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  enabled      Boolean         @default(true)
  trigger      String
  triggerValue String?
  condition    String          @default("")
  actions      String
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  runCount     Int             @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime        @default(now())
  runs         AutomationRun[]
}

model AutomationRun {
  id       String         @id @default(cuid())
  ruleId   String
  rule     AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  issueKey String
  success  Boolean
  message  String
  at       DateTime       @default(now())

  @@index([ruleId, at])
}
