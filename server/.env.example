# Caminho relativo à pasta prisma/
DATABASE_URL="file:./dev.db"
# Troque por um valor aleatório e longo em produção
JWT_SECRET="troque-este-segredo"
PORT=4000
# Endereço do frontend, usado nos links dos e-mails
APP_URL="http://localhost:5173"
# Pasta dos anexos (padrão: server/uploads)
# UPLOAD_DIR="/var/giro/uploads"
# SMTP para envio de e-mails. Sem SMTP_HOST, os e-mails são exibidos no console do servidor.
# SMTP_HOST="smtp.exemplo.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="GIRO <no-reply@exemplo.com>"
